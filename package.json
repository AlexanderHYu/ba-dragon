{
  "name": "ba-dragon",
  "version": "5.0.0-dev.0",
  "description": "龙区分类器 —— 断箭（Broken Arrow）对局复盘与龙区分工具",
  "main": "./out/main/index.js",
  "author": "AlexanderHYu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win --publish never",
    "smoke": "electron-vite build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-sqlite3-wasm": "^0.8.60"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.alexanderhyu.dragonclassifier",
    "productName": "龙区分类器",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "native/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "龙区分类器",
      "artifactName": "DragonClassifier-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DragonClassifier-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "LICENSE.txt"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AlexanderHYu",
        "repo": "ba-dragon"
      }
    ]
  }
}